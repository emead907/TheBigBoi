# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The app's public address (used in login links)
NEXT_PUBLIC_SITE_URL=https://hub.gymstarsidaho.com

# Email (resend.com → API Keys). The "from" address must be on a domain you verify in Resend.
RESEND_API_KEY=

# Texts (twilio.com → Account Info). Leave blank until A2P 10DLC registration is approved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Protects the daily reminder job. Any long random string; Vercel sends it automatically.
CRON_SECRET=
